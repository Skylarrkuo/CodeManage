# 本机开发配置模板。
#
# 用法：把本文件复制为同目录下的 application-local.yml 并填入你的真实值。
# application-local.yml 已在 .gitignore 中，不会被提交到仓库。
#
#   cp application-local.yml.example application-local.yml
#
# application.yml 默认激活 local profile，因此创建该文件后直接启动即可。

spring:
  datasource:
    # 本机 MySQL 密码
    password: "your-mysql-password"

jwt:
  # JWT 签名密钥（HS256），至少 32 字节的随机字符串。
  # 可用 `openssl rand -base64 48` 生成一个。
  secret: "please-generate-a-random-secret-at-least-32-bytes"

judge0:
  # 你的 Judge0 实例基础地址（不要带 /submissions）
  base-url: "http://localhost:2358"
